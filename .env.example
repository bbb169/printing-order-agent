# Copy this file to .env if the local file is missing.
# Never put real credentials into this tracked example.
# Your DeepSeek API key and chosen DeepSeek model.
API_KEY=
MODEL=deepseek-chat
BASE_URL=https://api.deepseek.com
# Relative to the working directory; run commands from this repository.
PRICE_LIST_PATH=config/prices.json
# Only an explicit process-environment flag enables live tests, not this file.
RUN_LIVE_TESTS=false
